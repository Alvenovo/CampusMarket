<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== 首页面板 ===== -->
        <LinearLayout
            android:id="@+id/panelHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#6750A4"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:text="校园二手交易"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_search"
                android:hint="搜索商品..."
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="暂无商品~"
                android:textColor="#999999"
                android:textSize="15sp"
                android:visibility="gone" />

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="12dp" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        </LinearLayout>

        <!-- ===== 发布面板 ===== -->
        <ScrollView
            android:id="@+id/panelPublish"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:text="发布商品"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="商品名称"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_input"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etPrice"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="价格（元）"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_input"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etContact"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="联系方式"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_input"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etDesc"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="商品描述"
                    android:gravity="top"
                    android:padding="14dp"
                    android:background="@drawable/bg_input"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/ivPreview"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_input"
                        android:src="@android:drawable/ic_menu_gallery" />

                    <Button
                        android:id="@+id/btnPickImage"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="选择图片"
                        android:textColor="#6750A4"
                        android:textSize="14sp"
                        android:background="@drawable/bg_outline_btn"
                        android:layout_marginStart="14dp"
                        android:paddingHorizontal="18dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPubSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="立即发布"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_button" />
            </LinearLayout>
        </ScrollView>

        <!-- ===== 我的面板 ===== -->
        <LinearLayout
            android:id="@+id/panelMine"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#F8F6FC"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="32dp"
                android:paddingBottom="24dp"
                android:layout_margin="16dp"
                android:background="@drawable/bg_mine_card">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_person"
                    android:clickable="true"
                    android:focusable="true"
                    app:civ_border_width="2dp"
                    app:civ_border_color="#FFFFFF" />

                <TextView
                    android:id="@+id/tvUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="用户"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="欢迎使用校园二手交易平台"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:id="@+id/btnMyGoods"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_menu_item"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_add" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="56dp"
                        android:text="我的发布"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:layout_marginStart="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:text="&gt;"
                        android:textColor="#CCCCCC"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnFavorite"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_menu_item"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_favorite" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="56dp"
                        android:text="我的收藏"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:layout_marginStart="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:text="&gt;"
                        android:textColor="#CCCCCC"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDealRecords"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_menu_item"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_recent_history" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="56dp"
                        android:text="买卖记录"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:layout_marginStart="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:text="&gt;"
                        android:textColor="#CCCCCC"
                        android:textSize="18sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="退出登录"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:background="#FF5722" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        app:itemIconSize="22dp"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav"/>

</LinearLayout>