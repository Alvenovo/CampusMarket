<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/splash_logo"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="校园二手交易"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tvSplashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="让闲置流动，让价值延续"
            android:textSize="14sp"
            android:textColor="#D0BCFF"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvSplashVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0 · CampusMarket"
            android:textSize="11sp"
            android:textColor="#B0A0D0"
            android:layout_marginTop="64dp" />

    </LinearLayout>

</FrameLayout>